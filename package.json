{
  "name": "iso20022-edu",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "npm run check:content && astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test src/i18n/t.test.ts scripts/import-xsd.test.ts scripts/extract-erepository.test.ts src/lib/content-schemas.test.ts src/lib/resolver.test.ts scripts/check-content.test.ts",
    "import-xsd": "node scripts/import-xsd.ts",
    "extract-erepository": "node scripts/extract-erepository.ts",
    "check:content": "node scripts/check-content.ts",
    "check:xml": "xmllint --noout --schema schemas/pacs.008.001.14.xsd src/content/samples/*.xml",
    "check:a11y": "node scripts/check-a11y.ts",
    "check:size": "node scripts/check-js-size.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/preact": "^6.1.6",
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "preact": "^11.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "fast-xml-parser": "^5.12.1",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript-eslint": "^8.73.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=24.2"
  }
}
