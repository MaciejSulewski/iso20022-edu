---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { sortTerms } from "../../lib/glossary";
import { t } from "../../i18n/t";

const terms = sortTerms(
  (await getCollection("glossary")).map((g) => ({ ...g.data })),
);
const base = import.meta.env.BASE_URL;
---

<Base title={t("glossary.title")} description={t("glossary.lead")}>
  <div class="mx-auto max-w-2xl px-4">
    <h1 class="text-3xl font-bold">{t("glossary.title")}</h1>
    <p class="mt-3 text-muted">{t("glossary.lead")}</p>
    <p class="mt-5 rounded border border-line border-l-4 border-l-accent bg-surface p-3 text-sm">
      {t("glossary.draft")}
    </p>
    <ul
      aria-label={t("glossary.list")}
      class="mt-6 grid gap-3"
      data-glossary-list
    >
      {terms.map((g) => (
        <li class="rounded border border-line p-3" data-glossary-term={g.id}>
          <h2 class="text-lg font-semibold">
            <a href={`${base}glossary/${g.id}/`}>{g.term}</a>
          </h2>
          <p class="mt-1 text-sm">{g.plain}</p>
        </li>
      ))}
    </ul>
  </div>
</Base>
