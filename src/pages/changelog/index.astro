---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { sortEntries } from "../../lib/changelog";
import { t } from "../../i18n/t";

const entries = sortEntries(
  (await getCollection("changelog")).map((c) => ({ ...c.data })),
);
const base = import.meta.env.BASE_URL;
---

<Base title={t("changelog.title")} description={t("changelog.lead")}>
  <div class="mx-auto max-w-2xl px-4">
    <h1 class="text-3xl font-bold">{t("changelog.title")}</h1>
    <p class="mt-3 text-muted">{t("changelog.lead")}</p>
    <div class="mt-6 grid gap-3" data-changelog-list>
      {entries.map((e) => (
        <article
          class="rounded border border-line p-3"
          data-changelog-entry={e.id}
        >
          <h2 class="text-lg font-semibold">{e.title}</h2>
          {/* the ISO date as text: the build is static, so no locale or timezone formatting */}
          <time class="text-sm text-muted" datetime={e.date}>
            {e.date}
          </time>
          <p class="mt-1 text-sm">{e.summary}</p>
          {e.messages.length > 0 && (
            <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm">
              {e.messages.map((m) => (
                <a class="underline" href={`${base}messages/${m}/`}>
                  {m}
                </a>
              ))}
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</Base>
