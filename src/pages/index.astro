---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import StartHere from "../components/StartHere";
import { STEPS } from "../lib/content-schemas";
import { toolHref } from "../lib/lesson-tools";
import { t, type UiKey } from "../i18n/t";

const base = import.meta.env.BASE_URL;
const lessons = await getCollection("lessons");
// A step with a tool shows "Open step". Its lesson is linked too; step 1's tool is its lesson.
// A step with neither shows "coming soon".
const steps = STEPS.map((id) => {
  const lesson = lessons.find((l) => l.data.step === id);
  const lessonHref = lesson && `${base}lessons/${lesson.id}/`;
  return {
    id,
    title: t(`home.step.${id}.title` as UiKey),
    desc: t(`home.step.${id}.desc` as UiKey),
    href: id === "lesson" ? lessonHref : toolHref(id, base),
    lessonHref,
    lessonTitle: lesson?.data.title,
  };
});
const labels = {
  progress: t("home.start.progress"),
  soon: t("home.start.soon"),
  done: t("home.start.done"),
  open: t("home.start.open"),
  lesson: t("home.start.lesson"),
};
---

<Base>
  <div class="mx-auto max-w-2xl px-4">
    <h1 class="text-3xl font-bold">{t("site.title")}</h1>
    <p class="mt-4 text-lg">{t("home.lead")}</p>
    <p class="mt-3 text-muted">{t("home.lead2")}</p>
    <h2 class="mt-10 text-2xl font-semibold">{t("home.start.title")}</h2>
    <p class="mt-2 mb-4 text-muted">{t("home.start.intro")}</p>
    <StartHere client:load steps={steps} labels={labels} />
    <p class="mt-4">
      <a href={`${base}lessons/`}>{t("home.start.alllessons")}</a>
    </p>
  </div>
</Base>
