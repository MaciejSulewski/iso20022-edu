---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Quiz from "../../components/Quiz";
import { t } from "../../i18n/t";

export async function getStaticPaths() {
  return (await getCollection("quizzes")).map((quiz) => ({
    params: { id: quiz.id },
    props: { quiz },
  }));
}

const { quiz } = Astro.props;
const { title, summary, message, lesson } = quiz.data;
const base = import.meta.env.BASE_URL;
const lessonLink = async (id: string, key: "quiz.lesson" | "quiz.back") => {
  const entry = await getEntry("lessons", id);
  if (!entry) throw new Error(`Lesson "${id}" missing for quiz ${quiz.id}`);
  return {
    href: `${base}lessons/${id}/`,
    text: t(key)
      .replace("{n}", String(entry.data.order))
      .replace("{title}", entry.data.title),
  };
};
const back = await lessonLink(lesson, "quiz.back");
const questions = await Promise.all(
  quiz.data.questions.map(async (q) => ({
    id: q.id,
    prompt: q.prompt,
    options: q.options,
    answer: q.answer,
    explanation: q.explanation,
    elements: q.elements,
    lesson: q.lesson ? await lessonLink(q.lesson, "quiz.lesson") : undefined,
  })),
);
const labels = {
  form: t("quiz.form"),
  check: t("quiz.check"),
  retry: t("quiz.retry"),
  score: t("quiz.score"),
  right: t("quiz.right"),
  wrong: t("quiz.wrong"),
  skipped: t("quiz.skipped"),
  answerIs: t("quiz.answerIs"),
  elements: t("quiz.elements"),
};
---

<Base title={title} description={summary}>
  <article class="mx-auto max-w-5xl px-4">
    <h1 class="text-3xl leading-tight font-bold">{title}</h1>
    <p class="mt-3 max-w-[65ch] text-lg text-muted">{summary}</p>
    <p class="mt-5 max-w-[65ch] rounded border border-line border-l-4 border-l-accent bg-surface p-3 text-sm">
      {t("quiz.draft")}
    </p>
    <p class="mt-5 max-w-[65ch]">{t("quiz.intro")}</p>

    <div class="mt-8">
      <Quiz
        client:load
        questions={questions}
        labels={labels}
        elementBase={`${base}messages/${message}/`}
      />
    </div>

    <p class="mt-10">
      <a href={back.href}>{back.text}</a>
    </p>
    <p class="mt-10 border-t border-line pt-4">
      <a href={`${base}lessons/`}>{t("lesson.all")}</a>
    </p>
  </article>
</Base>
