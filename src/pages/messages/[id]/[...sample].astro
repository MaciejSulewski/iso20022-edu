---
import { getCollection, getEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Workspace from "../../components/Workspace";
import { buildTree } from "../../lib/xml-tree";
import { childRecords } from "../../lib/schema-tree";
import { rootTypeName } from "../../lib/resolver";
import { t } from "../../i18n/t";
import type { Schema } from "../../../scripts/schema-model";

export async function getStaticPaths() {
  const samples = await getCollection("samples");
  return (await getCollection("messages"))
    .filter((m) => samples.some((s) => s.data.message === m.id))
    .map((message) => ({ params: { id: message.id }, props: { message } }));
}

const { message } = Astro.props;
const sample = (await getCollection("samples")).find(
  (s) => s.data.message === message.id,
)!;
// Vite ?raw keeps paths independent of the working directory.
const xmls = import.meta.glob("../../content/samples/*.xml", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
const schemas = import.meta.glob("../../data/schema/*.json", {
  import: "default",
  eager: true,
}) as unknown as Record<string, Schema>;
const a = (await getEntry("annotations", message.id))?.data;
const file = `../../content/samples/${sample.data.file}`;
const xml = xmls[file];
const schema = schemas[`../../data/schema/${message.id}.json`];
if (!xml) throw new Error(`Sample file missing for ${message.id}: ${file}`);
if (!schema) throw new Error(`Schema JSON missing for ${message.id}`);
const rootType = rootTypeName(schema);
if (!rootType) throw new Error(`No root type in ${message.id}`);
const nodes = buildTree(xml, schema, a);
// only the overlay maps reach the island; the schema stays at build time
const overlay = a && { byPath: a.byPath, byType: a.byType, codes: a.codes };
const states = {
  required: t("xml.state.required"),
  optional: t("xml.state.optional"),
  choice: t("xml.state.choice"),
  repeats: t("xml.state.repeats"),
};
const labels = {
  aside: t("xml.panel"),
  tabs: t("ws.tabs"),
  tab: {
    xml: t("ws.tab.xml"),
    tree: t("ws.tab.tree"),
    details: t("ws.tab.details"),
  },
  resizeXmlTree: t("ws.resize.xmlTree"),
  resizeTreeDetails: t("ws.resize.treeDetails"),
  resizeValue: t("ws.resize.value"),
  xmlTitle: t("xml.title"),
  treeTitle: t("tree.title"),
  treeLead: t("tree.lead"),
  legend: t("xml.legend"),
  legendNote: t("xml.legend.note"),
  states,
  hints: {
    required: t("xml.state.required.hint"),
    optional: t("xml.state.optional.hint"),
    choice: t("xml.state.choice.hint"),
    repeats: t("xml.state.repeats.hint"),
  },
  panel: {
    empty: t("xml.panel.empty"),
    path: t("xml.panel.path"),
    explanation: t("xml.panel.explanation"),
    none: t("xml.panel.none"),
    iso: t("xml.panel.iso"),
    facts: t("xml.panel.facts"),
    type: t("xml.fact.type"),
    use: t("xml.fact.use"),
    reqOnce: t("xml.occ.reqOnce"),
    optOnce: t("xml.occ.optOnce"),
    reqMany: t("xml.occ.reqMany"),
    optMany: t("xml.occ.optMany"),
    upTo: t("xml.occ.upTo"),
    atLeast: t("xml.occ.atLeast"),
    choiceMember: t("xml.panel.choiceMember"),
    choice: t("xml.panel.choice"),
    codes: t("xml.panel.codes"),
    codeExplained: t("xml.panel.codeExplained"),
    examples: t("xml.panel.examples"),
    notes: t("xml.panel.notes"),
  },
  xml: {
    tree: t("xml.tree"),
    collapse: t("xml.collapse"),
    expand: t("xml.expand"),
    count: t("xml.count"),
    states,
    mode: t("xml.mode"),
    modeHint: t("xml.mode.hint"),
    hidden: t("xml.hidden"),
    hiddenOne: t("xml.hidden.one"),
  },
  tree: {
    tree: t("tree.tree"),
    occurs: t("tree.occurs"),
    states,
    required: t("tree.required"),
    requiredHint: t("tree.required.hint"),
    search: t("tree.search"),
    searchHint: t("tree.search.hint"),
    searchLoading: t("tree.search.loading"),
    searchError: t("tree.search.error"),
    searchCount: t("tree.search.count"),
    searchOne: t("tree.search.one"),
    searchMore: t("tree.search.more"),
    searchNone: t("tree.search.none"),
    searchResults: t("tree.search.results"),
    loading: t("tree.loading"),
    error: t("tree.error"),
    retry: t("tree.retry"),
    recursive: t("tree.recursive"),
    any: t("tree.any"),
    anyHint: t("tree.any.hint"),
  },
};
---

<Base title={`${message.data.name} · ${t("xml.title")}`}>
  <div class="mx-auto max-w-5xl px-4">
    <h1 class="text-3xl font-bold break-words">{message.data.name}</h1>
    <p class="mt-1 font-mono text-sm text-muted">{message.id}</p>
    <p class="mt-4">{sample.data.scenario}</p>
    <p class="mt-2 mb-6 text-muted">{t("xml.lead")}</p>
  </div>
  <div class="mx-auto max-w-5xl px-4 xl:max-w-none">
    <Workspace
      client:load
      nodes={nodes}
      id={message.id}
      base={import.meta.env.BASE_URL}
      rootType={rootType}
      root={childRecords(schema, rootType)}
      overlay={overlay}
      labels={labels}
    >
      {schema.constraints && schema.constraints.length > 0 && (
        <details class="mt-8 rounded border border-line">
          <summary class="cursor-pointer px-4 py-2 font-semibold">
            {t("tree.constraints")} ({schema.constraints.length})
          </summary>
          <div class="border-t border-line px-4 py-3">
            <p class="mb-3 text-sm text-muted">{t("tree.constraints.lead")}</p>
            <dl class="space-y-3 text-sm">
              {schema.constraints.map((c) => (
                <div>
                  <dt class="font-mono font-semibold break-words">{c.name}</dt>
                  <dd class="mt-0.5">{c.definition}</dd>
                </div>
              ))}
            </dl>
          </div>
        </details>
      )}
    </Workspace>
  </div>
</Base>
