---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { WORKSPACE_ID, toolHref } from "../../lib/lesson-tools";
import { STEPS } from "../../lib/content-schemas";
import { t } from "../../i18n/t";

export async function getStaticPaths() {
  const lessons = (await getCollection("lessons")).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return lessons.map((lesson, i) => ({
    params: { slug: lesson.id },
    props: { lesson, prev: lessons[i - 1], next: lessons[i + 1] },
  }));
}

const { lesson, prev, next } = Astro.props;
const { Content } = await render(lesson);
const { title, summary, step, order, relatedElements, sources } = lesson.data;
const base = import.meta.env.BASE_URL;
const tool = toolHref(step, base);
---

<Base title={title} description={summary}>
  <article class="mx-auto max-w-2xl px-4">
    <p class="text-sm text-muted">
      {t("lesson.step")
        .replace("{n}", String(order))
        .replace("{total}", String(STEPS.length))}
    </p>
    <h1 class="mt-1 text-3xl leading-tight font-bold">{title}</h1>
    <p class="mt-3 text-lg text-muted">{summary}</p>
    <p class="mt-5 rounded border border-line border-l-4 border-l-accent bg-surface p-3 text-sm">
      {t("lesson.draft")}
    </p>

    <div class="lesson mt-6">
      <Content />
    </div>

    {relatedElements.length > 0 && (
      <section class="mt-10" aria-labelledby="related">
        <h2 id="related" class="text-xl font-semibold">
          {t("lesson.related")}
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {relatedElements.map((path) => (
            <li>
              <a
                class="inline-block rounded border border-line px-2 py-1 font-mono text-sm break-all"
                href={`${base}messages/${WORKSPACE_ID}/#${path}`}
              >
                {path}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {tool && (
      <p class="mt-6">
        <a href={tool}>{t("lesson.tool")}</a>
      </p>
    )}

    <section class="mt-10" aria-labelledby="sources">
      <h2 id="sources" class="text-xl font-semibold">
        {t("lesson.sources")}
      </h2>
      <ul class="mt-3 list-disc space-y-2 pl-6 text-sm">
        {sources.map((s) => (
          <li>
            <a href={s.url} class="break-words">
              {s.title}
            </a>{" "}
            <span class="text-muted">
              ({t("lesson.retrieved").replace("{date}", s.retrieved)})
            </span>
          </li>
        ))}
      </ul>
    </section>

    <nav
      aria-label={t("lesson.nav")}
      class="mt-10 flex flex-wrap justify-between gap-4 border-t border-line pt-4"
    >
      {prev ? (
        <a href={`${base}lessons/${prev.id}/`} rel="prev">
          {t("lesson.prev")}: {prev.data.title}
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={`${base}lessons/${next.id}/`} rel="next">
          {t("lesson.next")}: {next.data.title}
        </a>
      )}
    </nav>
    <p class="mt-4">
      <a href={`${base}lessons/`}>{t("lesson.all")}</a>
    </p>
  </article>
</Base>
