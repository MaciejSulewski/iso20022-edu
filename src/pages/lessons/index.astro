---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { STEPS } from "../../lib/content-schemas";
import { t } from "../../i18n/t";

const lessons = (await getCollection("lessons")).sort(
  (a, b) => a.data.order - b.data.order,
);
const base = import.meta.env.BASE_URL;
---

<Base title={t("lessons.title")} description={t("lessons.lead")}>
  <div class="mx-auto max-w-2xl px-4">
    <h1 class="text-3xl font-bold">{t("lessons.title")}</h1>
    <p class="mt-3 text-muted">{t("lessons.lead")}</p>
    <ol class="mt-6 grid gap-3">
      {lessons.map((l) => (
        <li class="rounded border border-line p-3">
          <p class="text-sm text-muted">
            {t("lesson.step")
              .replace("{n}", String(l.data.order))
              .replace("{total}", String(STEPS.length))}
          </p>
          <h2 class="mt-1 text-lg font-semibold">
            <a href={`${base}lessons/${l.id}/`}>{l.data.title}</a>
          </h2>
          <p class="mt-1 text-sm">{l.data.summary}</p>
        </li>
      ))}
    </ol>
    <p class="mt-6">
      <a href={`${base}glossary/`}>{t("glossary.link")}</a>
    </p>
  </div>
</Base>
