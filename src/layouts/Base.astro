---
import "../styles/global.css";
import { getCollection } from "astro:content";
import ThemeToggle from "../components/ui/ThemeToggle";
import Palette from "../components/Palette";
import { t } from "../i18n/t";

const lang = Astro.currentLocale ?? "en";
const {
  title,
  description = t("site.description"),
  noindex = false,
  pagefind = !noindex, // false keeps the page out of the Pagefind index
} = Astro.props;
const fullTitle = title ? `${title} · ${t("site.title")}` : t("site.title");
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
// messages that have a page (the ones with a sample); each also has a tree index
const samples = await getCollection("samples");
const messages = (await getCollection("messages"))
  .filter((m) => samples.some((s) => s.data.message === m.id))
  .map((m) => ({
    id: m.id,
    name: m.data.name,
    url: `${base}messages/${m.id}/`,
    indexUrl: `${base}tree/${m.id}/index.json`,
  }));
const labels = {
  open: t("palette.open"),
  shortcut: t("palette.shortcut"),
  shortcutMac: t("palette.shortcut.mac"),
  title: t("palette.title"),
  input: t("palette.input"),
  hint: t("palette.hint"),
  groupElements: t("palette.group.elements"),
  groupPages: t("palette.group.pages"),
  retry: t("palette.retry"),
  status: {
    "palette.count": t("palette.count"),
    "palette.count.one": t("palette.count.one"),
    "palette.none": t("palette.none"),
    "palette.showing": t("palette.showing"),
    "palette.loading": t("palette.loading"),
    "palette.error": t("palette.error"),
  },
};
const ogImage = new URL(`${import.meta.env.BASE_URL}og.png`, Astro.site);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      try {
        const s = localStorage.getItem("theme");
        if (
          s === "dark" ||
          (s !== "light" && matchMedia("(prefers-color-scheme: dark)").matches)
        )
          document.documentElement.classList.add("dark");
      } catch {
        // storage blocked: fall back to the light default
      }
    </script>
    {noindex && <meta name="robots" content="noindex" />}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t("site.title")} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={t("site.og_alt")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header class="flex items-center justify-between gap-4 p-4">
      <a href={import.meta.env.BASE_URL}>{t("site.title")}</a>
      <div class="flex items-center gap-2">
        <Palette
          client:idle
          messages={messages}
          pagefindUrl={`${base}pagefind/pagefind.js`}
          labels={labels}
        />
        <ThemeToggle client:load label={t("theme.toggle")} />
      </div>
    </header>
    <main
      {...(pagefind
        ? { "data-pagefind-body": "" }
        : { "data-pagefind-ignore": "" })}
    >
      <slot />
    </main>
    <footer class="mx-4 mt-8 mb-4 border-t border-line pt-4 text-sm text-muted">
      <p>{t("footer.disclaimer")}</p>
      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
        <a
          class="underline hover:text-fg"
          href="https://github.com/MaciejSulewski/iso20022-edu/blob/main/LICENSE"
        >
          {t("footer.code_licence")}
        </a>
        <a
          class="underline hover:text-fg"
          href="https://github.com/MaciejSulewski/iso20022-edu/blob/main/CONTENT-LICENSE"
        >
          {t("footer.content_licence")}
        </a>
        <a class="underline hover:text-fg" href={`${base}changelog/`}>
          {t("footer.changelog")}
        </a>
      </p>
    </footer>
  </body>
</html>
