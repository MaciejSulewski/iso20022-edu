---
import "../styles/global.css";
import { t } from "../i18n/t";

const lang = Astro.currentLocale ?? "en";
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{t("site.title")}</title>
  </head>
  <body>
    <header>
      <a href={import.meta.env.BASE_URL}>{t("site.title")}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <slot name="footer" />
    </footer>
  </body>
</html>
