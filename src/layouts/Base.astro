---
import "../styles/global.css";
import { t } from "../i18n/t";

const lang = Astro.currentLocale ?? "en";
const { title, description = t("site.description") } = Astro.props;
const fullTitle = title ? `${title} · ${t("site.title")}` : t("site.title");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${import.meta.env.BASE_URL}og.png`, Astro.site);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t("site.title")} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={t("site.og_alt")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <header>
      <a href={import.meta.env.BASE_URL}>{t("site.title")}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="mx-4 mt-8 mb-4 border-t border-neutral-300 pt-4 text-sm text-neutral-700">
      <p>{t("footer.disclaimer")}</p>
      <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
        <a
          class="underline hover:text-neutral-900"
          href="https://github.com/MaciejSulewski/iso20022-edu/blob/main/LICENSE"
        >
          {t("footer.code_licence")}
        </a>
        <a
          class="underline hover:text-neutral-900"
          href="https://github.com/MaciejSulewski/iso20022-edu/blob/main/CONTENT-LICENSE"
        >
          {t("footer.content_licence")}
        </a>
      </p>
    </footer>
  </body>
</html>
